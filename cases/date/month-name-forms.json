      ],
      "since": "0.1.0"
    },
    {
      "id": "date/lowercase-month",
      "text": "april 1999",
      "expect": {
        "spans": [
          {
            "start": 0,
            "end": 10,
            "type": "date",
            "text": "april 1999"
          }
        ],
        "filtered_text": "{{{REDACTED-date}}}"
      },
      "rationale": [
        "Month names match case insensitively."
