      "since": "0.1.0"
    },
    {
      "id": "date/abbreviated-month-with-period",
      "text": "On Aug. 31, 2020, Plaintiff, Wendy J. Christophersen, was appointed as interim",
      "expect": {
        "spans": [
          {
            "start": 3,
            "end": 16,
            "type": "date",
            "text": "Aug. 31, 2020"
          }
        ],
        "filtered_text": "On {{{REDACTED-date}}}, Plaintiff, Wendy J. Christophersen, was appointed as interim"
      },
      "rationale": [
        "An abbreviated month with a trailing period, as used in legal filings."
      ],
      "since": "0.1.0"
    },
    {
      "id": "date/month-day-year-no-comma",
      "text": "The date of March 4 1932 was fun",
      "expect": {
        "spans": [
          {
            "start": 12,
            "end": 24,
            "type": "date",
            "text": "March 4 1932"
          }
        ],
        "filtered_text": "The date of {{{REDACTED-date}}} was fun"
      },
      "rationale": [
        "A month-day-year with no comma."
      ],
      "since": "0.1.0"
    },
    {
      "id": "date/in-legal-sentence",
      "text": "That on July 3, 2012 an involuntary petition on behalf of FKAAHS, Inc. fka Aire",
      "expect": {
        "spans": [
          {
            "start": 8,
            "end": 20,
            "type": "date",
            "text": "July 3, 2012"
          }
        ],
        "filtered_text": "That on {{{REDACTED-date}}} an involuntary petition on behalf of FKAAHS, Inc. fka Aire"
      },
      "rationale": [
        "A date inside a longer sentence containing a company name."
      ],
      "since": "0.1.0"
    },
    {
      "id": "date/in-sentence-with-name",
      "text": "On August 22, 2012, Plaintiff, Wendy J. Christophersen, was appointed as interim",
      "expect": {
        "spans": [
          {
            "start": 3,
            "end": 18,
            "type": "date",
            "text": "August 22, 2012"
          }
        ],
        "filtered_text": "On {{{REDACTED-date}}}, Plaintiff, Wendy J. Christophersen, was appointed as interim"
      },
      "rationale": [
        "A date followed by a personal name, which must not extend the span."
      ],
      "since": "0.1.0"
    },
    {
      "id": "date/month-year-in-clinical-note",
      "text": "Owns and drives his own vehicle but states he has not driven his car since last October 2009.",
      "expect": {
        "spans": [
          {
            "start": 80,
            "end": 92,
            "type": "date",
            "text": "October 2009"
          }
        ],
        "filtered_text": "Owns and drives his own vehicle but states he has not driven his car since last {{{REDACTED-date}}}."
      },
      "rationale": [
        "A month-and-year reference inside a clinical narrative."
      ],
      "since": "0.1.0"
    }
  ]
