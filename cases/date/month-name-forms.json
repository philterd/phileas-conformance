          }
        ],
        "filtered_text": "{{{REDACTED-date}}}"
      },
      "rationale": [
        "A second th ordinal, on a different month."
      ],
      "since": "0.1.0"
    },
    {
      "id": "date/month-and-year",
      "text": "January 2012",
      "expect": {
        "spans": [
          {
            "start": 0,
