{
  "schema": 1,
  "policy": "policies/date-redact.json",
  "tags": [
    "regex",
    "date"
  ],
  "cases": [
    {
      "id": "date/month-day-year",
      "text": "May 22, 1999",
      "expect": {
        "spans": [
          {
            "start": 0,
            "end": 12,
            "type": "date",
            "text": "May 22, 1999"
          }
        ],
        "filtered_text": "{{{REDACTED-date}}}"
      },
      "rationale": [
        "Abbreviated-month form with a comma."
      ],
      "since": "0.1.0"
    },
    {
      "id": "date/full-month-day-year",
      "text": "November 22, 1999",
      "expect": {
        "spans": [
          {
            "start": 0,
            "end": 17,
            "type": "date",
            "text": "November 22, 1999"
          }
        ],
        "filtered_text": "{{{REDACTED-date}}}"
      },
      "rationale": [
        "Full month name, day, comma, four-digit year."
      ],
      "since": "0.1.0"
    },
    {
      "id": "date/single-digit-day",
      "text": "November 2, 1999",
      "expect": {
        "spans": [
          {
            "start": 0,
            "end": 16,
            "type": "date",
            "text": "November 2, 1999"
          }
        ],
        "filtered_text": "{{{REDACTED-date}}}"
      },
      "rationale": [
        "A single-digit day must not need padding."
      ],
      "since": "0.1.0"
    },
    {
      "id": "date/ordinal-day-suffix",
      "text": "November 22nd, 1999",
      "expect": {
        "spans": [
          {
            "start": 0,
            "end": 19,
            "type": "date",
            "text": "November 22nd, 1999"
          }
        ],
        "filtered_text": "{{{REDACTED-date}}}"
      },
      "rationale": [
        "An ordinal suffix attached to the day."
      ],
      "since": "0.1.0"
    },
    {
      "id": "date/ordinal-suffix-detached",
      "text": "November 22 nd, 1999",
      "expect": {
        "spans": [
          {
            "start": 0,
            "end": 20,
            "type": "date",
            "text": "November 22 nd, 1999"
          }
        ],
        "filtered_text": "{{{REDACTED-date}}}"
      },
      "rationale": [
        "The ordinal suffix separated by a space, which happens in extracted text."
      ],
      "since": "0.1.0"
    },
    {
      "id": "date/month-and-ordinal-day-no-year",
      "text": "November 22nd",
      "expect": {
        "spans": [
          {
            "start": 0,
            "end": 13,
            "type": "date",
            "text": "November 22nd"
          }
        ],
        "filtered_text": "{{{REDACTED-date}}}"
      },
      "rationale": [
        "A month and ordinal day with no year is still a date."
      ],
      "since": "0.1.0"
    },
    {
      "id": "date/month-ordinal-first",
      "text": "May 1st",
      "expect": {
        "spans": [
          {
            "start": 0,
            "end": 7,
            "type": "date",
            "text": "May 1st"
          }
        ],
        "filtered_text": "{{{REDACTED-date}}}"
      },
      "rationale": [
        "The 1st ordinal form."
      ],
      "since": "0.1.0"
    },
    {
      "id": "date/month-ordinal-first-spaced",
      "text": "May 1 st",
      "expect": {
        "spans": [
          {
            "start": 0,
            "end": 8,
            "type": "date",
            "text": "May 1 st"
          }
        ],
        "filtered_text": "{{{REDACTED-date}}}"
      },
      "rationale": [
        "The 1st ordinal with a detached suffix."
      ],
      "since": "0.1.0"
    },
