      "since": "0.1.0"
    },
    {
      "id": "date/month-and-year-november",
      "text": "November 1999",
      "expect": {
        "spans": [
          {
            "start": 0,
            "end": 13,
            "type": "date",
            "text": "November 1999"
          }
        ],
        "filtered_text": "{{{REDACTED-date}}}"
      },
      "rationale": [
