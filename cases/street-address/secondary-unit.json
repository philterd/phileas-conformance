{
  "schema": 1,
  "policy": "policies/street-address-redact.json",
  "tags": [
    "regex",
    "street-address",
    "unit"
  ],
  "cases": [
    {
      "id": "street-address/suite-abbreviated",
      "text": "4 Devonshire Ct ste 2",
      "expect": {
        "spans": [
          {
            "start": 0,
            "end": 21,
            "type": "street-address",
            "text": "4 Devonshire Ct ste 2"
          }
        ],
        "filtered_text": "{{{REDACTED-street-address}}}"
      },
      "rationale": [
        "A ste secondary-unit designator is part of the address."
      ],
      "since": "0.1.0"
    },
    {
      "id": "street-address/apartment-spelled-out",
      "text": "4 Devonshire Ct apartment 222",
      "expect": {
        "spans": [
          {
            "start": 0,
            "end": 29,
            "type": "street-address",
            "text": "4 Devonshire Ct apartment 222"
          }
        ],
        "filtered_text": "{{{REDACTED-street-address}}}"
      },
      "rationale": [
        "The full word 'apartment' with a unit number."
      ],
      "since": "0.1.0"
    },
    {
      "id": "street-address/apartment-abbreviated",
      "text": "4 Devonshire Ct apt 222",
      "expect": {
        "spans": [
          {
            "start": 0,
            "end": 23,
            "type": "street-address",
            "text": "4 Devonshire Ct apt 222"
          }
        ],
        "filtered_text": "{{{REDACTED-street-address}}}"
      },
      "rationale": [
        "The apt abbreviation."
      ],
      "since": "0.1.0"
    },
    {
      "id": "street-address/unit-then-trailing-text",
      "text": "4 Devonshire Ct apt 222 anywhere",
      "expect": {
        "spans": [
          {
            "start": 0,
            "end": 23,
            "type": "street-address",
            "text": "4 Devonshire Ct apt 222"
          }
        ],
        "filtered_text": "{{{REDACTED-street-address}}} anywhere"
      },
      "rationale": [
        "Text after the unit number must not extend the span; this is what stops an address swallowing the rest of a sentence."
      ],
      "since": "0.1.0"
    },
    {
      "id": "street-address/unit-mid-sentence",
      "text": "address is 9444 Heritage St. apt 2 over there",
      "expect": {
        "spans": [
          {
            "start": 11,
            "end": 34,
            "type": "street-address",
            "text": "9444 Heritage St. apt 2"
          }
        ],
        "filtered_text": "address is {{{REDACTED-street-address}}} over there"
      },
      "rationale": [
        "An address with a unit, surrounded by text."
      ],
      "since": "0.1.0"
    },
    {
      "id": "street-address/comma-separated-suite",
      "text": "445 Minnesota Street, Suite 175",
      "expect": {
        "spans": [
          {
            "start": 0,
            "end": 31,
            "type": "street-address",
            "text": "445 Minnesota Street, Suite 175"
          }
        ],
        "filtered_text": "{{{REDACTED-street-address}}}"
      },
      "rationale": [
        "A comma before Suite, the form used on business correspondence."
      ],
      "since": "0.1.0"
    }
  ]
}
